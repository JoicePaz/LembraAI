<header class="sticky top-0 z-50 border-b border-slate-100 bg-white/95 shadow-sm backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-3 sm:flex-row sm:items-center sm:gap-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-3 sm:contents">
      <%= link_to root_path, class: "flex shrink-0 items-center rounded-lg outline-none ring-brand focus-visible:ring-2 focus-visible:ring-offset-2" do %>
        <%= image_tag "lembraai-logo.png", alt: "LembraAI", class: "h-11 w-auto sm:h-12" %>
      <% end %>
      <div class="flex items-center gap-2 sm:hidden">
        <%= link_to new_deck_path, class: "inline-flex h-11 w-11 items-center justify-center rounded-full bg-brand text-white shadow-md shadow-brand/25 outline-none transition hover:brightness-95 active:scale-[0.98] focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2", "aria-label": "Create flashcard deck" do %>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
        <% end %>
      </div>
    </div>
    <form class="min-w-0 flex-1" action="<%= decks_path %>" method="get" role="search">
      <label class="sr-only" for="landing-search">Search</label>
      <div class="relative">
        <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400" aria-hidden="true">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
        </span>
        <input
          id="landing-search"
          type="search"
          name="q"
          placeholder="Search decks or cards"
          class="h-11 w-full rounded-full border border-slate-200 bg-slate-50/80 pl-10 pr-4 text-sm text-slate-900 placeholder:text-slate-400 outline-none transition focus:border-brand/40 focus:bg-white focus:placeholder:text-transparent focus:ring-2 focus:ring-brand/20"
          autocomplete="off"
        />
      </div>
    </form>
    <div class="hidden sm:block">
      <%= link_to new_deck_path, class: "inline-flex h-11 w-11 items-center justify-center rounded-full bg-brand text-white shadow-md shadow-brand/25 outline-none transition hover:brightness-95 active:scale-[0.98] focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2", "aria-label": "Create flashcard deck" do %>
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
      <% end %>
    </div>
  </div>
</header>
