<%= render "shared/landing_header" %>

<div class="bg-gradient-to-b from-surface via-white to-surface">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20">
    <div class="w-full rounded-3xl border border-slate-100 bg-gradient-to-br from-white via-surface to-white p-6 shadow-xl shadow-slate-200/50 sm:p-8">
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-4xl">Deck not found</h1>
      <p class="mt-3 text-sm text-slate-600 sm:text-base">
        No results found for
        <span class="font-semibold text-slate-900">"<%= @query %>"</span>.
      </p>
      <p class="mt-1 text-sm text-slate-500">Try another term or create a new deck.</p>
    </div>

    <div class="mt-10 flex items-center justify-center gap-3">
      <%= link_to "See all decks",
          decks_path,
          class: "ui-gray-cta inline-flex items-center justify-center rounded-2xl bg-slate-300 px-8 py-4 text-base font-semibold text-slate-800 shadow-md shadow-slate-400/40 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-500 focus-visible:ring-offset-2" %>
      <%= link_to "Create a deck",
          new_deck_path,
          class: "inline-flex items-center justify-center rounded-2xl bg-gradient-to-r from-brand to-[#ff7f2a] px-8 py-4 text-base font-semibold text-white shadow-lg shadow-brand/25 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_16px_34px_rgba(253,100,0,0.35)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2" %>
    </div>
  </section>
</div>
