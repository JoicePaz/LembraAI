<%= render "shared/landing_header" %>

<div class="bg-gradient-to-b from-surface via-white to-surface">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20" data-controller="deck-delete-modal">
    <div class="w-full rounded-3xl border border-slate-100 bg-gradient-to-br from-white via-surface to-white p-6 shadow-xl shadow-slate-200/50 sm:p-8">
      <header>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-4xl">My decks</h1>
      </header>
      <% if flash[:import_summary].present? %>
        <p
          class="mt-3 text-sm font-semibold text-brand transition-opacity duration-300"
          data-controller="transient-badge"
          data-transient-badge-timeout-value="3000"
        >
          <%= flash[:import_summary] %>
        </p>
      <% end %>

      <% if @decks.any? %>
        <ul class="mt-8 list-disc space-y-3 ps-6 marker:text-slate-400">
          <% @decks.each do |deck| %>
            <li>
              <div class="flex items-center justify-between gap-4">
                <%= link_to deck.title, practice_deck_path(deck), class: "text-sm font-medium text-brand transition hover:underline" %>
                <div class="flex items-center gap-2">
                  <%= link_to(
                    edit_deck_path(deck),
                    aria: { label: "Edit deck" },
                    class: "ui-hover-gray-dark inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-xl border border-slate-300 bg-slate-200 text-slate-600 shadow-sm transition-all duration-200 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-500 focus-visible:ring-offset-2"
                  ) do %>
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a2.25 2.25 0 1 1 3.182 3.182L10.582 17.13a4.5 4.5 0 0 1-1.897 1.13l-2.685.896.895-2.685a4.5 4.5 0 0 1 1.13-1.897L16.862 4.487Zm0 0L19.5 7.125" />
                    </svg>
                  <% end %>
                  <button
                    type="button"
                    aria-label="Delete deck"
                    data-action="click->deck-delete-modal#open"
                    data-delete-path="<%= deck_path(deck) %>"
                    data-deck-title="<%= deck.title %>"
                    class="ui-hover-gray-dark inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-xl border border-slate-300 bg-slate-200 text-slate-600 shadow-sm transition-all duration-200 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-500 focus-visible:ring-offset-2"
                  >
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 6.75h18M9.75 6.75V5.25A1.5 1.5 0 0 1 11.25 3.75h1.5a1.5 1.5 0 0 1 1.5 1.5v1.5m-8.25 0V18A2.25 2.25 0 0 0 8.25 20.25h7.5A2.25 2.25 0 0 0 18 18V6.75M10.5 10.5v6m3-6v6" />
                    </svg>
                  </button>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-8 text-sm text-slate-500">No decks yet. Create your first one.</p>
      <% end %>

      <div
        aria-hidden="true"
        style="position: fixed; inset: 0; z-index: 90; display: none; align-items: center; justify-content: center; background: rgba(15, 23, 42, 0.45); padding: 1rem;"
        data-deck-delete-modal-target="modal"
        data-action="click->deck-delete-modal#close"
      >
        <div style="position: relative; width: 100%; max-width: 440px; max-height: calc(100vh - 2rem); padding: 0.75rem;" data-action="click->deck-delete-modal#ignoreModalClick">
          <div style="position: relative; background: #ffffff; border: 1px solid #d1d5db; border-radius: 0.75rem; box-shadow: 0 12px 28px rgba(15, 23, 42, 0.24); padding: 1rem;">
            <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #d1d5db; padding-bottom: 0.75rem;">
              <h2 style="font-size: 1rem; line-height: 1.4; font-weight: 600; color: #1f2937;">Delete deck?</h2>
              <button
                type="button"
                aria-label="Close modal"
                data-action="click->deck-delete-modal#close"
                style="display: inline-flex; height: 2.25rem; width: 2.25rem; align-items: center; justify-content: center; border: 0; border-radius: 0.75rem; background: transparent; color: #64748b; cursor: pointer;"
              >
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M18 18 6 6" />
                </svg>
              </button>
            </div>

            <div style="padding-top: 1rem; padding-bottom: 1rem;">
              <p style="font-size: 0.9rem; line-height: 1.5; color: #6b7280;">
                This will permanently remove <strong data-deck-delete-modal-target="deckName"></strong> and all its flashcards.
              </p>
            </div>

            <div style="display: flex; align-items: center; justify-content: flex-end; gap: 0.75rem; border-top: 1px solid #d1d5db; padding-top: 0.75rem;">
              <button
                type="button"
                data-action="click->deck-delete-modal#close"
                style="display: inline-flex; align-items: center; justify-content: center; border-radius: 0.75rem; border: 1px solid #d1d5db; background: #f3f4f6; padding: 0.5rem 1rem; font-size: 0.875rem; font-weight: 500; color: #374151; cursor: pointer;"
              >
                Cancel
              </button>
              <form method="post" action="#" data-deck-delete-modal-target="form">
                <input type="hidden" name="_method" value="delete">
                <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
                <button
                  type="submit"
                  style="display: inline-flex; align-items: center; justify-content: center; border-radius: 0.75rem; border: 1px solid transparent; background: #fd6400; padding: 0.5rem 1rem; font-size: 0.875rem; font-weight: 600; color: #ffffff; cursor: pointer;"
                >
                  Delete
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>

    </div>

    <div class="mt-10 flex justify-center">
      <%= link_to "Create more",
          new_deck_path,
          class: "ui-gray-cta inline-flex items-center justify-center rounded-2xl bg-slate-300 px-8 py-4 text-base font-semibold text-slate-800 shadow-md shadow-slate-400/40 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-500 focus-visible:ring-offset-2" %>
    </div>
  </section>
</div>
