<%= render "shared/landing_header" %>
<%= render "shared/pwa_install_banner" %>

<div class="bg-gradient-to-b from-surface via-white to-surface">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="order-1 lg:order-1">
        <h1 class="text-balance text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
          The simplest way to build flashcards and remember what matters.
        </h1>
        <p class="mt-5 max-w-xl text-pretty text-base leading-relaxed text-slate-600 sm:text-lg">
          Create decks in minutes, study anywhere, and keep momentum with short review sessions—designed to fit your day.
        </p>
        <ul class="mt-8 space-y-4">
          <li class="flex gap-4">
            <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand" aria-hidden="true">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 6.878V6a2.25 2.25 0 0 1 2.25-2.25h7.5A2.25 2.25 0 0 1 18 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 0 0 4.5 9v.878m15 0A2.25 2.25 0 0 1 19.5 9V6a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 6v3m15 0v.878a2.25 2.25 0 0 1-.75 1.683l-4.5 3.375a2.25 2.25 0 0 1-2.25 0l-4.5-3.375a2.25 2.25 0 0 1-.75-1.683V9" />
              </svg>
            </span>
            <div>
              <p class="font-semibold text-slate-900">Decks in a few taps</p>
              <p class="text-sm text-slate-600">Clear front and back, no fuss.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand" aria-hidden="true">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-9.75 9h10.5" />
              </svg>
            </span>
            <div>
              <p class="font-semibold text-slate-900">Study on phone or desktop</p>
              <p class="text-sm text-slate-600">Layout tuned for small and large screens.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand" aria-hidden="true">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
              </svg>
            </span>
            <div>
              <p class="font-semibold text-slate-900">Focus on what you need to review</p>
              <p class="text-sm text-slate-600">Organize by subject, exam, or goal.</p>
            </div>
          </li>
        </ul>
        <div class="mt-10">
          <%= link_to start_decks_path, class: "group relative inline-flex w-full items-center justify-center overflow-hidden rounded-2xl bg-gradient-to-r from-brand to-[#ff7f2a] px-8 py-4 text-base font-semibold text-white shadow-lg shadow-brand/25 outline-none transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_16px_34px_rgba(253,100,0,0.35)] active:translate-y-0 active:shadow-lg focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 sm:w-auto" do %>
            <span class="pointer-events-none absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/35 to-transparent transition-transform duration-700 group-hover:translate-x-full"></span>
            <span class="relative"><%= @has_decks ? "See decks" : "Create a deck" %></span>
          <% end %>
        </div>
      </div>

      <div class="order-2 lg:order-2">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <div class="rounded-3xl border border-slate-100 bg-gradient-to-br from-white via-surface to-white p-6 shadow-xl shadow-slate-200/50 sm:p-8">
            <div class="flex items-center gap-2 text-slate-700">
              <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand text-white shadow-sm" aria-hidden="true">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 6.878V6a2.25 2.25 0 0 1 2.25-2.25h7.5A2.25 2.25 0 0 1 18 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 0 0 4.5 9v.878m15 0A2.25 2.25 0 0 1 19.5 9V6a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 6v3m15 0v.878a2.25 2.25 0 0 1-.75 1.683l-4.5 3.375a2.25 2.25 0 0 1-2.25 0l-4.5-3.375a2.25 2.25 0 0 1-.75-1.683V9" />
                </svg>
              </span>
              <span class="text-sm font-semibold tracking-wide text-slate-800">Astronomy</span>
            </div>
            <div class="relative mt-8 min-h-[240px] sm:min-h-[280px]">
              <%= render "shared/flashcard_flip",
                  front_text: "Which planet has the most confirmed moons?",
                  back_text: "Saturn currently has the highest number of confirmed moons.",
                  cards: [
                    { front: "Which planet has the most confirmed moons?", back: "Saturn currently has the highest number of confirmed moons." },
                    { front: "How long does sunlight take to reach Earth?", back: "Around 8 minutes and 20 seconds." },
                    { front: "Why does the Moon seem to change shape?", back: "We see different portions of its sunlit side during its orbit around Earth." }
                  ],
                  show_stack: true,
                  card_id: "hero-demo-flashcard" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
